# LLM Configuration
LLM_MODEL_PATH=./models/qwen2.5-coder-1.5b-instruct-q4_k_m.gguf
LLM_CONTEXT_SIZE=4096
LLM_THREADS=4

# Memory & Resource Constraints (in Megabytes)
RAM_TARGET_MB=3500
RAM_HARD_LIMIT_MB=4000
WATCHDOG_INTERVAL_SEC=1.0

# Server API & Network Isolation
SERVER_HOST=127.0.0.1
SERVER_PORT=8000
ALLOW_NETWORK=false
ALLOW_SUDO=false

# Operating Modes: normal | autonomous | lab
APP_MODE=normal

# Workspace Root
WORKSPACE_ROOT=/home/lesaint/Projects

# Logging & Storage Configuration
LOG_LEVEL=INFO
LOG_DIR=./logs
MEMORY_DIR=./memory

# Memory Configuration (Neon Cloud PostgreSQL & Zero Local Disk)
MEMORY_MODE=neant
PERSIST_TO_DISK=false
LOG_TO_FILE=false
NEON_DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require

# Filesystem Permissions (Computer-wide read access & solution search)
ALLOW_GLOBAL_READ=true
ALLOW_FULL_FS_ACCESS=true

# Online Unrestricted Models (Grok, DeepSeek, Qwen - 100% Remote API, zero local load)
ONLINE_PROVIDER=auto
ONLINE_MODEL=deepseek/deepseek-chat
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
GROK_API_KEY=
GROQ_API_KEY=

# Distributed GPU & LAN Compute Swarm
REMOTE_GPU_URL=
LAN_CLUSTER_NODES=

